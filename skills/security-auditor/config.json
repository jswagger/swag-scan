{
  "models": {
    "claude": { "basic": "haiku", "advanced": "sonnet" },
    "copilot": { "basic": null, "advanced": null }
  },
  "diff": {
    "baseRef": "auto",
    "untrackedMaxBytes": 100000
  },
  "scan": {
    "exclude": [
      "package-lock.json",
      "yarn.lock",
      "pnpm-lock.yaml",
      "**/testdata/**",
      "**/locales/**/*.json",
      "**/locale/**/*.json",
      "**/i18n/**/*.json",
      "**/translations/**/*.json",
      "**/bin/**",
      "**/obj/**",
      "*.Designer.cs",
      "*.md",
      "*.tsbuildinfo",
      "*.snap"
    ],
    "testFiles": {
      "mode": "lower-confidence",
      "patterns": [
        "*.test.*",
        "*.spec.*",
        "**/__tests__/**",
        "**/test/**",
        "**/tests/**"
      ]
    },
    "projectStack": "backend",
    "readOnlyPaths": [],
    "dataAccess": {
      "sqlHelpers": ["sql_helper", "SqlHelper", "db_helper", "DbHelper"],
      "sqlHelperWriteMethods": ["execute_non_query", "executenonquery", "insert", "update", "delete", "upsert", "merge", "bulk", "write", "commit", "executemany"],
      "allowedProcedures": [],
      "tenantPredicates": ["UserGuid", "TenantGuid", "TenantId", "OrgId", "OrganizationId", "AccountId"]
    },
    "llm": {
      "modelCallWrappers": [
        "_converse_sync", "converse", "converse_stream", "invoke_model", "invoke_model_with_response_stream",
        "ConverseAsync", "InvokeModelAsync", "messages.create", "messages.stream", "chat.completions.create",
        "responses.create", "completions.create", "generate_content", "generateContent", "chat.send"
      ],
      "promptFilePatterns": ["*prompt*", "*guardrail*", "*system_message*", "*instructions*"]
    }
  },
  "scope": {
    "maxRelatedFiles": 5,
    "maxRelationshipHops": 1
  }
}